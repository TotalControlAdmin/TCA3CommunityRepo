        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Prevent popups (Windows)",
        "description": "Removes the Call of Duty 4 crash/safe-mode marker and creates a server profile so the dedicated server starts without Windows dialogs.",
        "code": "IF EXIST __iw3mp (\n  attrib -h __iw3mp\n  del __iw3mp\n)\n\nfor /d %%f in (*) do (\n  if /i not \u0022%%f\u0022==\u0022Docs\u0022 if /i not \u0022%%f\u0022==\u0022miles\u0022 if /i not \u0022%%f\u0022==\u0022pb\u0022 if /i not \u0022%%f\u0022==\u0022zone\u0022 (\n    IF NOT EXIST \u0022%%f\\players\\profiles\u0022 md \u0022%%f\\players\\profiles\u0022\n    echo tcadmin\u003E \u0022%%f\\players\\profiles\\active.txt\u0022\n    IF NOT EXIST \u0022%%f\\players\\profiles\\tcadmin\u0022 md \u0022%%f\\players\\profiles\\tcadmin\u0022\n  )\n)",
        "runImpersonated": false,
