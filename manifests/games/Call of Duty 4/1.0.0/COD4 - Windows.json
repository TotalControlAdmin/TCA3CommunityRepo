        "scriptEvents": [
          "AfterUpdateInstall"
        ],
        "name": "Activate CoD4X server",
        "description": "Backs up the stock iw3mp.exe and runs the CoD4X server in its place.",
        "code": "IF NOT EXIST cod4x18_dedrun.exe (\n  echo cod4x18_dedrun.exe was not downloaded.\n  exit /b 1\n)\nIF NOT EXIST iw3mp_stock.exe IF EXIST iw3mp.exe copy /y iw3mp.exe iw3mp_stock.exe\ncopy /y cod4x18_dedrun.exe iw3mp.exe\necho CoD4X server activated. Players without CoD4X are prompted to install the CoD4X client.",
        "runImpersonated": false,
