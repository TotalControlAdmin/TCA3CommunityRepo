        ],
        "name": "Restore stock CoD4 server",
        "description": "Puts the original iw3mp.exe back after CoD4X was installed.",
        "code": "IF EXIST iw3mp_stock.exe (\n  copy /y iw3mp_stock.exe iw3mp.exe\n  del /q iw3mp_stock.exe\n  echo Stock CoD4 1.7 server restored.\n) ELSE (\n  echo Stock iw3mp.exe already in use.\n)\nIF EXIST cod4x18_dedrun.exe del /q cod4x18_dedrun.exe",
