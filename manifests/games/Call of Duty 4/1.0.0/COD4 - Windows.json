  "configFiles": [
    {
      "id": 9,
      "relativePath": "main\\server.cfg",
      "description": "Main server configuration file",
      "template": "// ==================================================\n// Call of Duty 4 Server Configuration\n// ==================================================\n\n// Passwords\nset rcon_password \u0022${RconPassword}\u0022\nset g_password \u0022${PrivatePassword}\u0022\nset sv_privatePassword \u0022\u0022\nset sv_privateClients \u00220\u0022\n\n// Logging\nset g_log \u0022games_mp.log\u0022\nset g_logSync \u00221\u0022\nset logfile \u00221\u0022\n\n// Security\nset sv_pure \u00221\u0022\nset sv_cheats \u00220\u0022\nset sv_floodProtect \u00221\u0022\nset sv_disableClientConsole \u00220\u0022\n\n// Server info\nset sv_hostname \u0022${Hostname}\u0022\nsets g_needpass \u00220\u0022\n\n// Network / downloads\nset sv_maxRate \u002225000\u0022\nset sv_minPing \u00220\u0022\nset sv_maxPing \u0022350\u0022\nset sv_allowDownload \u00221\u0022\nset sv_wwwDownload \u00220\u0022\nset sv_wwwBaseURL \u0022\u0022\n\n// Gameplay\nset scr_hardcore \u00220\u0022\nset scr_oldschool \u00220\u0022\nset scr_team_fftype \u00220\u0022\nset scr_teambalance \u00221\u0022\nset scr_game_allowkillcam \u00221\u0022\nset scr_game_spectatetype \u00221\u0022\nset g_allowvote \u00221\u0022\n\n// Match limits\nset scr_war_scorelimit \u0022750\u0022\nset scr_war_timelimit \u002210\u0022\nset scr_dm_scorelimit \u0022150\u0022\nset scr_dm_timelimit \u002210\u0022\nset scr_sd_scorelimit \u00224\u0022\nset scr_sd_timelimit \u00222.5\u0022\nset scr_sd_roundlimit \u00220\u0022\nset scr_dom_scorelimit \u0022200\u0022\nset scr_dom_timelimit \u00220\u0022\nset scr_koth_scorelimit \u0022250\u0022\nset scr_koth_timelimit \u002215\u0022\nset scr_sab_scorelimit \u00222\u0022\nset scr_sab_timelimit \u002220\u0022\n\n// CoD4X only: master server listing token (optional, see cod4x.ovh)\n//set sv_authtoken \u0022\u0022\n\n// Map rotation (team deathmatch). Other modes: dm, sd, dom, koth, sab.\nset g_gametype \u0022war\u0022\nset sv_mapRotation \u0022gametype war map mp_backlot gametype war map mp_bloc gametype war map mp_bog gametype war map mp_broadcast gametype war map mp_carentan gametype war map mp_cargoship gametype war map mp_citystreets gametype war map mp_convoy gametype war map mp_countdown gametype war map mp_crash gametype war map mp_crash_snow gametype war map mp_creek gametype war map mp_crossfire gametype war map mp_farm gametype war map mp_killhouse gametype war map mp_overgrown gametype war map mp_pipeline gametype war map mp_shipment gametype war map mp_showdown gametype war map mp_strike gametype war map mp_vacant\u0022\n",
      "order": 0,
