  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "Powershell",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Project Zomboid pre-start (chmod \u002B Java heap)",
        "description": "Project Zomboid pre-start (chmod \u002B Java heap)",
        "code": "#!/usr/bin/env pwsh\n# Project Zomboid (Linux) pre-start. Runs as the service user on every start, so it\n# also self-heals after a Steam update replaces the game files.\n$root = $ThisService.RootDirectory\nWrite-Host \u0022[pz-prestart] root \u0027$root\u0027\u0022\ntry { Set-Location -LiteralPath $root -ErrorAction Stop } catch {\n    Write-Host \u0022[pz-prestart] ERROR: service root not found: $root\u0022; exit 1 }\n[Environment]::CurrentDirectory = $PWD.ProviderPath\n\n# DepotDownloader extracts files as 0644; restore the execute bits.\nforeach ($f in \u0027start-server.sh\u0027, \u0027ProjectZomboid64\u0027, \u0027jre64/bin/java\u0027) {\n    if (Test-Path -LiteralPath $f) { chmod \u002Bx $f } }\n\n# JVM heap from the MaxRam variable.\n$ram = \u0027\u0027\ntry { $ram = [string]$ThisService.Variables[\u0027MaxRam\u0027] } catch { }\nif ($ram -notmatch \u0027^\\d\u002B[mMgG]$\u0027) { $ram = \u00274g\u0027 }\n$json = \u0027ProjectZomboid64.json\u0027\nif (Test-Path -LiteralPath $json) {\n    $t = Get-Content -Raw -LiteralPath $json\n    # Build 42 also sets -Xms; Java refuses to start if -Xms \u003E -Xmx, so set both.\n    $n = $t -replace \u0027\u0022-Xm([sx])\\d\u002B[mMgG]\u0022\u0027, (\u0027\u0022-Xm${1}\u0027 \u002B $ram \u002B \u0027\u0022\u0027)\n    if ($n -ne $t) { Set-Content -NoNewline -LiteralPath $json -Value $n }\n    Write-Host \u0022[pz-prestart] heap set to -Xms/-Xmx $ram\u0022\n} else { Write-Host \u0022[pz-prestart] WARNING: $json not found, heap unchanged\u0022 }\n\nNew-Item -ItemType Directory -Force -Path \u0022$root/Zomboid/Server\u0022 | Out-Null\n\n# An empty SandboxVars/spawnregions file makes PZ exit on load. Delete it so PZ regenerates defaults.\nforeach ($n in \u0027servertest_SandboxVars.lua\u0027, \u0027servertest_spawnregions.lua\u0027) {\n    $f = Join-Path (Join-Path (Join-Path $root \u0027Zomboid\u0027) \u0027Server\u0027) $n\n    if ((Test-Path -LiteralPath $f) -and -not ((Get-Content -Raw -LiteralPath $f) -match \u0027\\S\u0027)) {\n        Remove-Item -LiteralPath $f -Force; Write-Host \u0022[pz-prestart] removed empty $n\u0022 } }\nWrite-Host \u0022[pz-prestart] done\u0022\n",
        "runImpersonated": true,
        "stopService": false,
        "ignoreErrors": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "48ecf22e-5b51-438e-9ff2-c00830ffa13f"
      }
    },
