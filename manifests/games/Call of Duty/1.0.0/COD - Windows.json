      "id": 13,
      "relativePath": "main\\server.cfg",
      "description": "Main server configuration file",
      "template": "// ==================================================\n// Call of Duty 1.5 Server Configuration\n// ==================================================\n\n// Passwords\nset rcon_password \u0022${RconPassword}\u0022\nset g_password \u0022${PrivatePassword}\u0022\nset sv_privatePassword \u0022\u0022\n\n// Logging\nset g_log \u0022games_mp.log\u0022\nset g_logSync \u00221\u0022\n\n// Security\nset sv_pure \u00221\u0022\nset sv_cheats \u00220\u0022\nset sv_floodProtect \u00221\u0022\n\n// Server info\nset sv_hostname \u0022${Hostname}\u0022\nset scr_motd \u0022Welcome to the server\u0022\nsets g_needpass \u00220\u0022\n\n// Network / downloads\nset sv_maxRate \u002225000\u0022\nset sv_minPing \u00220\u0022\nset sv_maxPing \u0022300\u0022\nset sv_allowDownload \u00221\u0022\nset sv_allowAnonymous \u00220\u0022\n\n// Gameplay\nset scr_friendlyfire \u00220\u0022\nset scr_killcam \u00221\u0022\nset scr_drawfriend \u00221\u0022\nset scr_teambalance \u00221\u0022\nset scr_forcerespawn \u00220\u0022\nset g_allowvote \u00220\u0022\n\n// Match limits\nset scr_tdm_scorelimit \u0022100\u0022\nset scr_tdm_timelimit \u002230\u0022\nset scr_dm_scorelimit \u002250\u0022\nset scr_dm_timelimit \u002230\u0022\nset scr_sd_scorelimit \u002210\u0022\nset scr_sd_timelimit \u00220\u0022\nset scr_sd_roundlength \u00224\u0022\nset scr_sd_graceperiod \u002215\u0022\nset scr_re_scorelimit \u002210\u0022\nset scr_re_roundlength \u00224\u0022\nset scr_bel_scorelimit \u002250\u0022\nset scr_bel_timelimit \u002230\u0022\n\n// Map rotation (team deathmatch). Change \u0022tdm\u0022 to dm, sd, re or bel for other modes.\nset g_gametype \u0022tdm\u0022\nset sv_mapRotation \u0022gametype tdm map mp_bocage gametype tdm map mp_brecourt gametype tdm map mp_carentan gametype tdm map mp_chateau gametype tdm map mp_dawnville gametype tdm map mp_depot gametype tdm map mp_harbor gametype tdm map mp_hurtgen gametype tdm map mp_pavlov gametype tdm map mp_powcamp gametype tdm map mp_railyard gametype tdm map mp_rocket gametype tdm map mp_ship gametype tdm map mp_neuville gametype tdm map mp_stalingrad gametype tdm map mp_tigertown\u0022\n",
